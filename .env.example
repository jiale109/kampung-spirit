# Copy this file to .env and fill in the values from your own Supabase project
# (Project Settings -> Data API for the URL, Project Settings -> API Keys for the key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# OneMap (https://www.onemap.gov.sg/apidocs). Optional: search works without
# one today, but OneMap may start requiring it. A token lasts about 3 days,
# so renew it from your OneMap account if the map stops working.
VITE_ONEMAP_TOKEN=
